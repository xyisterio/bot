BOT_TOKEN=твой_токен_от_BotFather

# Порядок провайдеров через запятую — бот пробует их слева направо,
# переключаясь на следующий при ошибке/лимите/недоступности модели.
# Провайдер без заданного ключа просто пропускается.
PROVIDER_ORDER=gemini,groq

# Gemini (ключ бесплатно на aistudio.google.com/apikey)
GEMINI_API_KEY=твой_ключ_от_aistudio.google.com
GEMINI_MODEL=gemini-2.5-flash

# Groq (ключ бесплатно на console.groq.com/keys) — используется как фолбэк
GROQ_API_KEY=твой_ключ_от_console.groq.com
GROQ_MODEL=openai/gpt-oss-120b,llama-3.3-70b-versatile

PORT=3000
